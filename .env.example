# ─────────────────────────────────────────────────────────────
# WordPress + WooCommerce — shop-dev.rasakopi.coffee (dev)
# Copy ke .env lalu isi. .env di-ignore di git (jangan commit!).
# ─────────────────────────────────────────────────────────────

# Domain
WP_SITEURL=https://shop-dev.rasakopi.coffee

# Admin (installer WP-CLI)
WP_ADMIN_USER=rasaadmin
WP_ADMIN_EMAIL=it@rasagroup.global
# WAJIB ganti sebelum first-run
WP_ADMIN_PASSWORD=ChangeMe-GenerateRandom123!

# Database
WORDPRESS_DB_HOST=shop-woo-db
WORDPRESS_DB_NAME=shop_woo
WORDPRESS_DB_USER=woo
WORDPRESS_DB_PASSWORD=ChangeMe-DbRandom123!

# Resource limits (server hanya ~2GB RAM, 11 container lain jalan)
PHP_MEMORY_LIMIT=256M
PHP_MAX_EXECUTION_TIME=120
PHP_MAX_INPUT_VARS=3000
MYSQL_INNODB_BUFFER_POOL=256M
MYSQL_MAX_CONNECTIONS=50

# WooCommerce
WOOCOMMERCE_CURRENCY=IDR
